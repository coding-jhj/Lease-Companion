{
  "$id": "lease-companion/practice-result-v1.9.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "점수 없이 행동·신호·공식 근거로 구성한 최종 복기.",
  "properties": {
    "action_summary": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Action Summary",
      "type": "array"
    },
    "confirmed_action_ids": {
      "items": {
        "type": "string"
      },
      "title": "Confirmed Action Ids",
      "type": "array"
    },
    "confirmed_actions": {
      "items": {
        "type": "string"
      },
      "title": "Confirmed Actions",
      "type": "array"
    },
    "ending_title": {
      "default": "확인 행동을 더 구체적으로 표현해 보세요",
      "title": "Ending Title",
      "type": "string"
    },
    "ending_type": {
      "default": "insufficient_protection",
      "enum": [
        "rights_asserted",
        "insufficient_protection",
        "transaction_stopped"
      ],
      "title": "Ending Type",
      "type": "string"
    },
    "feedback": {
      "default": "중요한 조건을 확인하고 문서로 남기겠다는 의사를 더 명확하게 표현할 필요가 있습니다.",
      "title": "Feedback",
      "type": "string"
    },
    "feedback_label": {
      "default": "보완할 점",
      "title": "Feedback Label",
      "type": "string"
    },
    "missed_action_ids": {
      "items": {
        "type": "string"
      },
      "title": "Missed Action Ids",
      "type": "array"
    },
    "missed_signals": {
      "items": {
        "type": "string"
      },
      "title": "Missed Signals",
      "type": "array"
    },
    "next_actions": {
      "items": {
        "type": "string"
      },
      "title": "Next Actions",
      "type": "array"
    },
    "official_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Official Source Ids",
      "type": "array"
    },
    "practice_phrase": {
      "default": "확인 자료와 수정된 계약 문구를 보기 전에는 계약이나 송금을 진행하지 않겠습니다.",
      "title": "Practice Phrase",
      "type": "string"
    },
    "recommended_phrases": {
      "items": {
        "type": "string"
      },
      "title": "Recommended Phrases",
      "type": "array"
    },
    "scenario_id": {
      "pattern": "^PRACTICE-[A-Z0-9-]+-\\d{3}$",
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Scenario Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.9.0",
      "enum": [
        "1.8.0",
        "1.9.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "selected_action": {
      "anyOf": [
        {
          "enum": [
            "진행",
            "추가 확인",
            "특약 수정 요구",
            "보류",
            "중단"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Action"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "scenario_id",
    "scenario_version"
  ],
  "title": "PracticeResult",
  "type": "object",
  "x-schema-version": "1.9.0"
}
